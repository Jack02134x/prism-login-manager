#!/bin/sh
# PLM helper: small listings the greeter needs, as tab-separated lines.
#
#   plm-helper users [SYNCROOT]   name  uid  real-name  home  shell  avatar  poster
#   plm-helper sessions           type  id  name  comment  exec  desktop-names
#   plm-helper themes DIR...      id  dir  name   (first DIR wins for a repeated id)
#   plm-helper media DIR...       path  (images, gifs and videos, newest first)
#   plm-helper caps               path of the caps-lock LED's brightness file
#   plm-helper host               hostname
#
# Kept to POSIX sh + awk so the login screen doesn't need Python.

set -u

cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
users)
    min=$(awk '$1 == "UID_MIN" { print $2 }' /etc/login.defs 2>/dev/null)
    max=$(awk '$1 == "UID_MAX" { print $2 }' /etc/login.defs 2>/dev/null)
    sync=${1:-/var/lib/plm/users}
    getent passwd | awk -F: -v min="${min:-1000}" -v max="${max:-60000}" '
        $3 >= min && $3 <= max && $7 !~ /(nologin|false)$/ {
            real = $5; sub(/,.*/, "", real)
            printf "%s:%s:%s:%s:%s\n", $1, $3, real, $6, $7
        }' | while IFS=: read -r name uid real home shell; do
        # the first picture we can actually read (as the greeter user)
        avatar=
        for f in "$sync/$name/avatar" "/var/lib/AccountsService/icons/$name" "$home/.face" "$home/.face.icon"; do
            if [ -r "$f" ] && [ -s "$f" ]; then avatar=$f; break; fi
        done
        poster=
        [ -r "$sync/$name/poster.jpg" ] && poster=$sync/$name/poster.jpg
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$uid" "$real" "$home" "$shell" "$avatar" "$poster"
    done
    ;;

sessions)
    has_startx=0
    command -v startx >/dev/null 2>&1 && has_startx=1
    for type in wayland x11; do
        if [ "$type" = wayland ]; then dirs="/usr/share/wayland-sessions /usr/local/share/wayland-sessions"
        else dirs="/usr/share/xsessions /usr/local/share/xsessions"; fi
        [ "$type" = x11 ] && [ "$has_startx" = 0 ] && continue
        for d in $dirs; do
            [ -d "$d" ] || continue
            for f in "$d"/*.desktop; do
                [ -f "$f" ] || continue
                line=$(awk -v type="$type" -v file="$f" '
                    BEGIN { FS = "=" }
                    /^\[/ { section = $0; next }
                    section != "[Desktop Entry]" { next }
                    {
                        key = $1; val = substr($0, length($1) + 2)
                        gsub(/\t/, " ", val)
                        if (key == "Name") name = val
                        else if (key == "Comment") comment = val
                        else if (key == "Exec") exec = val
                        else if (key == "TryExec") tryexec = val
                        else if (key == "DesktopNames") desk = val
                        else if (key == "Hidden" && val == "true") hidden = 1
                        else if (key == "NoDisplay" && val == "true") hidden = 1
                    }
                    END {
                        if (hidden || exec == "") exit
                        id = file; sub(/.*\//, "", id); sub(/\.desktop$/, "", id)
                        gsub(/;$/, "", desk); gsub(/;/, ":", desk)
                        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", type, id, name == "" ? id : name, comment, exec, desk, tryexec
                    }' "$f")
                [ -n "$line" ] || continue
                tryexec=$(printf '%s' "$line" | cut -f7)
                if [ -n "$tryexec" ] && ! command -v "$tryexec" >/dev/null 2>&1; then continue; fi
                printf '%s\n' "$line" | cut -f1-6
            done
        done
    done
    ;;

themes)
    seen=" "
    for d in "$@"; do
        [ -d "$d" ] || continue
        for t in "$d"/*/theme.json; do
            [ -f "$t" ] || continue
            dir=${t%/theme.json}
            id=${dir##*/}
            case "$seen" in *" $id "*) continue ;; esac
            seen="$seen$id "
            name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$t" | head -n 1)
            printf '%s\t%s\t%s\n' "$id" "$dir" "${name:-$id}"
        done
    done
    ;;

media)
    for d in "$@"; do
        [ -d "$d" ] || continue
        find "$d" -maxdepth 2 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \
            -o -iname '*.gif' -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' \) \
            -printf '%T@\t%p\n' 2>/dev/null
    done | sort -rn | cut -f2-
    ;;

caps)
    for f in /sys/class/leds/*::capslock/brightness; do
        [ -r "$f" ] && { printf '%s\n' "$f"; break; }
    done
    ;;

host)
    cat /proc/sys/kernel/hostname 2>/dev/null || hostname
    ;;

*)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
